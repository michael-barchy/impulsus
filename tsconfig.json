{
    "compilerOptions": {
        "ignoreDeprecations": "6.0",
        "target": "es5",
        "module": "es2015",
        "lib": [
            "es5",
            "dom"
        ],
        "strict": false,
        "alwaysStrict": false,
        "noImplicitAny": false,
        "moduleResolution": "node",
        "skipLibCheck": true,
        "removeComments": false
    },
    "include": [
        "src/**/*.ts"
    ]
}